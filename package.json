        "esbuild": "0.28.1",
        "eslint-plugin-neverthrow": "^1.1.4",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "obsidian": "latest",
        "prettier": "^2.8.8",
        "ts-jest": "^29.1.1",
